{
  "name": "nonchalant-rush-hud",
  "version": "0.1.0",
  "description": "Nonchalant Rush HUD — быстрые стрелки для шахматных задач",
  "author": "Rasher08",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "setup": "npm ci --no-audit --no-fund && node node_modules/electron/install.js",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "tsx tests/engine.test.ts && tsx tests/controller.test.ts && tsx tests/server.test.ts",
    "test:extension": "npm run build && electron tests/extension.electron.cjs",
    "smoke": "npm run build && electron . --rush-smoke",
    "benchmark": "tsx tests/benchmark.ts",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never"
  },
  "build": {
    "toolsets": { "nsis": "1.2.1" },
    "appId": "com.nonchalant.rushhud",
    "productName": "Nonchalant Rush HUD",
    "directories": { "output": "release" },
    "files": ["dist/**/*", "!dist/stockfish/**/*", "!dist/stockfish-native/**/*", "!dist/browser-extension/**/*", "package.json"],
    "extraResources": [
      { "from": "dist/browser-extension", "to": "browser-extension" },
      { "from": "dist/stockfish", "to": "stockfish" },
      { "from": "dist/stockfish-native", "to": "stockfish-native" }
    ],
    "win": { "target": ["portable", "nsis"], "executableName": "Nonchalant Rush HUD" },
    "nsis": {
      "oneClick": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Nonchalant-Rush-HUD-${version}-setup.${ext}",
      "shortcutName": "Nonchalant Rush HUD"
    },
    "portable": { "artifactName": "Nonchalant-Rush-HUD-${version}-portable.${ext}" }
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.25.12",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
