{
  "name": "nonchalant-local-hud",
  "version": "0.1.11",
  "description": "Tal HUD Mentality — correct chess sacrifices with compensation",
  "author": "Rasher08",
  "private": true,
  "main": "dist/main.cjs",
  "scripts": {
    "setup": "npm ci --no-audit --no-fund && node node_modules/electron/install.js",
    "build": "node build.mjs",
    "start": "npm run build && electron .",
    "typecheck": "tsc --project tsconfig.json",
    "test": "tsx tests/soundStore.test.ts && tsx tests/analysisSettings.test.ts && tsx tests/analysisSide.test.ts && tsx tests/soundPlayer.test.ts && tsx tests/recognition.test.ts && tsx tests/controller.test.ts && tsx tests/moveHistory.test.ts && node tests/extension.test.cjs && tsx tests/depthGate.test.ts && tsx tests/candidateSearch.test.ts && tsx tests/detector.test.ts",
    "test:sound": "npm run build && electron . --hud-sound-smoke",
    "test:moves": "npm run build && electron tests/moves.electron.cjs",
    "smoke": "npm run build && electron . --hud-smoke",
    "test:raster": "electron tests/recognition.electron.cjs",
    "test:game": "tsx tests/game-replay.test.ts",
    "test:reported-game": "tsx tests/reportedGame.test.ts",
    "test:game:raster": "electron tests/game-raster.electron.cjs",
    "dist:win": "npm run build && electron-builder --win portable nsis --x64 --publish never",
    "dist:win-portable": "npm run build && electron-builder --win portable --x64 --publish never"
  },
  "build": {
    "toolsets": {
      "nsis": "1.2.1"
    },
    "appId": "com.nonchalant.hud",
    "productName": "Tal HUD Mentality",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "!dist/stockfish/**/*",
      "!dist/browser-extension/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "dist/browser-extension",
        "to": "browser-extension",
        "filter": [
          "*"
        ]
      },
      {
        "from": "dist/stockfish",
        "to": "stockfish",
        "filter": [
          "*"
        ]
      }
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "executableName": "Tal HUD Mentality"
    },
    "nsis": {
      "oneClick": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "artifactName": "Tal-HUD-Mentality-${version}-setup.${ext}",
      "shortcutName": "Tal HUD Mentality",
      "uninstallDisplayName": "Tal HUD Mentality ${version}"
    },
    "portable": {
      "artifactName": "Tal-HUD-Mentality-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "45.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "0.25.12",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
