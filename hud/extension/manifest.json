{
  "manifest_version": 3,
  "name": "Tal HUD Mentality · список ходов",
  "version": "0.1.4",
  "description": "Передаёт запись ходов Chess.com в локальный Tal HUD Mentality. Без записи экрана.",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Tal HUD Mentality" },
  "content_scripts": [{ "matches": ["https://www.chess.com/*", "https://chess.com/*"], "js": ["content.js"], "run_at": "document_idle" }],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://127.0.0.1:18319" }
}
